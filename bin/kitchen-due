#!/bin/bash

# kitchen due [--repo DIR]: says whether the weekly review is due. The date
# lives in the private repo's kitchen/review.json, so it holds across
# sessions and machines. A snooze lives in kitchen/snooze, which git
# ignores, so it stays on the machine where it was set.
#
# Prints one of:
#   due: <why>          then, for someone with a cookbook, indented lines
#                       saying what's waiting to share
#   snoozed: until <when>
#   not due: next review on <date>

set -o pipefail
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../lib/kitchen.sh"
kitchen_find_repo "$@"
repo=$KITCHEN_REPO

now=$(kitchen_now)
today=$(date -d "@$now" +%F)
every=$(kitchen_settings "$repo" | jq -r '.review_every_days')
last=$(jq -r '.last_review // empty' "$repo/kitchen/review.json")

snooze=""
if [[ -f $repo/kitchen/snooze ]]; then
  snooze=$(head -n1 "$repo/kitchen/snooze")
  if [[ $snooze =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{1,2}:[0-9]{2})?$ ]] &&
    until=$(date -d "$snooze" +%s 2>/dev/null) && ((now < until)); then
    echo "snoozed: until $snooze"
    exit 0
  fi
fi

if [[ -n $last ]]; then
  due_on=$(date -d "$last + $every days" +%F)
  if [[ $today < $due_on ]]; then
    echo "not due: next review on $due_on"
    exit 0
  fi
  if [[ $today == "$due_on" ]]; then
    echo "due: the weekly review is due today (last review $last)"
  else
    echo "due: the weekly review was due on $due_on (last review $last)"
  fi
else
  echo "due: the weekly review has never run"
fi

# What a review would look at, from local data only (no network at session
# start). Only people with a cookbook publish, so only they hear about
# changes worth sharing: commits since the last review, leaving out ones
# that only touch kitchen/ and ones that apply or undo a recipe (those are
# published as applied copies instead), plus applied recipes not yet
# published.
cookbook=$(kitchen_expand "$(kitchen_settings "$repo" | jq -r '.cookbook')")
[[ -f $cookbook/cookbook.json ]] || exit 0

through=$(jq -r '.reviewed_through // empty' "$repo/kitchen/review.json")
if [[ -n $through ]]; then
  commits=0
  while IFS= read -r sha; do
    changed=$(git -C "$repo" show --name-only --format= "$sha")
    grep -q '^kitchen/applied/' <<<"$changed" && continue
    grep -qv '^kitchen/' <<<"$changed" && commits=$((commits + 1))
  done < <(git -C "$repo" log --format=%H "$through..HEAD" 2>/dev/null)
  ((commits)) && echo "  $commits commit$([[ $commits == 1 ]] || echo s) since the last review"
fi

queued=0
for record in "$repo"/kitchen/applied/*.json; do
  [[ -f $record ]] || continue
  [[ $(jq -r '.published' "$record") == false ]] && queued=$((queued + 1))
done
((queued)) && echo "  $queued applied recipe$([[ $queued == 1 ]] || echo s) waiting to be published"
exit 0

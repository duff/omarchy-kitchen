#!/bin/bash

# kitchen flags RECIPE_DIR [--serious]: lists warning signs a safety reviewer should
# look at closely. Unlike check, these aren't errors: a good recipe can use
# sudo. They point the reviewer at the lines that matter. No flags doesn't
# mean safe.
#
# Code warnings look only at what runs: the Fix, Apply and check, and Undo
# sections, the files the recipe ships, and the paths its data says it
# touches. A problem description that mentions curl or ~/.ssh isn't one.
# Hidden text and words aimed at an AI agent are looked for everywhere,
# since that's where they'd hide.
#
# --serious lists only the signs of a cookbook not to trust: reading
# secrets, sending data off the machine, fetching code, hidden content, and
# text aimed at an agent. Root, background services, and agent settings are
# routine for honest recipes, and their labels already say so.

set -o pipefail
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../lib/kitchen.sh"
source "$KITCHEN_LIB/labels.sh"

dir=${1:-}
[[ -f $dir/RECIPE.md ]] || kitchen_die "kitchen flags: which recipe folder?"
serious=0
[[ ${2:-} == --serious ]] && serious=1

KINDS=(
  "reads secrets or private data"
  "sends data off the machine"
  "downloads or runs code from the internet"
  "hides or decodes content"
  "runs as root"
  "starts something that runs on its own"
  "changes agent instructions or settings"
  "speaks to an AI agent"
)
SERIOUS=(
  "reads secrets or private data"
  "sends data off the machine"
  "downloads or runs code from the internet"
  "hides or decodes content"
  "speaks to an AI agent"
)
((serious)) && KINDS=("${SERIOUS[@]}")

declare -A RULES=(
  ["reads secrets or private data"]='\.ssh\b|\.gnupg\b|(?i:\bkeyrings?\b)|\.password-store\b|\.netrc\b|\.aws/credentials|\.docker/config\.json|\.kube/config|/etc/(?:shadow|sudoers)\b|(?i:(?:google-chrome|chromium|BraveSoftware|\.mozilla|firefox)\b.*(?:Cookies|Login Data|logins\.json|key4\.db))|\bprintenv\b|/proc/[^/\s]+/environ|\$\{?[A-Z_]*(?:TOKEN|SECRET|PASSWORD|API_KEY)\b|\b(?:secret-tool|op\s+read|op\s+item\s+get)\b'
  ["sends data off the machine"]='\bcurl\b[^\n]*(?:\s-d\b|--data|\s-F\b|--form|--upload-file|\s-T\b)|\bwget\b[^\n]*--post|\b(?:nc|ncat|socat)\b|/dev/(?:tcp|udp)/|\bscp\b|\brsync\b[^\n]*\S+:'
  ["downloads or runs code from the internet"]='\b(?:curl|wget)\b|\bgit\s+clone\b|\bomarchy\s+(?:plugin\s+add|theme\s+install)\b|\b(?:pip3?|pipx|cargo|go)\s+install\b|\bnpm\s+(?:i|install)\b|\b(?:yay|paru)\s+-S'
  ["hides or decodes content"]='\bbase64\s+(?:-d|--decode)\b|\bxxd\s+-r\b|\bopenssl\s+enc\b|(?<!hyprctl )\beval\b|\bbash\s+-c\s+"\$\(|\bsh\s+-c\s+"\$\(|[A-Za-z0-9+/=]{120,}'
  ["runs as root"]="${LABEL_COMMANDS[root]}"
  ["starts something that runs on its own"]="${LABEL_COMMANDS[runs]}|${LABEL_PATHS[runs]}"
  ["changes agent instructions or settings"]="${LABEL_COMMANDS[agent_config]}|${LABEL_PATHS[agent_config]}|(?i:\bpermissions\b.*\ballow\b)|--dangerously|\bbypassPermissions\b"
  ["speaks to an AI agent"]='(?i:ignore (?:all |any )?(?:previous|prior|earlier|above) (?:instructions|rules))|(?i:do not (?:tell|show|mention|inform)[^.\n]{0,40}\b(?:user|human|person|owner)\b)|(?i:\b(?:you are|as) an? (?:AI|agent|assistant|language model)\b)|(?i:\bsystem prompt\b)|(?i:\bnew instructions\b)|(?i:\b(?:apply|run|install|execute|do)\w*\b[^.\n]{0,40}\bwithout (?:asking|checking|confirming|confirmation)\b)|(?i:\bagents?\b[^.\n]{0,30}\b(?:applying|reading|reviewing|installing|using) (?:this|the) recipe\b)|(?i:\b(?:pre-?approved|approved (?:every|all) (?:step|change)s?)\b)'
)

# Kinds that look at the whole text, not just the code.
WHOLE_TEXT=("speaks to an AI agent")

files=()
while IFS= read -r rel; do
  kitchen_is_text "$dir/$rel" && files+=("$rel")
done < <(kitchen_files "$dir")

# RECIPE.md with everything but the runnable parts blanked out, so line
# numbers still point at the real file.
code_view=$(mktemp)
trap 'rm -f "$code_view"' EXIT
awk "$_kitchen_fences"'
  { was_fence = fence_check() }
  !was_fence && fence == "" && /^## / { name = substr($0, 4); sub(/[ \t]+$/, "", name); print ""; next }
  name == "Fix" || name == "Apply and check" || name == "Undo" { print; next }
  name == "Recipe data" && /"touches"/ { print; next }
  { print "" }
' "$dir/RECIPE.md" >"$code_view"

# Prints "kind: file:line: text" for every line of the given files that
# matches the kind's pattern. The first file is shown as RECIPE.md.
report() {
  local kind=$1 pattern=$2 shown=$3 hit line text
  shift 3
  while IFS= read -r hit; do
    [[ -n $hit ]] || continue
    line=$(cut -d: -f1 <<<"$hit")
    text=$(sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' <<<"${hit#*:}")
    echo "$kind: $shown:$line: ${text:0:100}"
  done < <(grep -nP -- "$pattern" "$@" 2>/dev/null || true)
}

output=$(
  for kind in "${KINDS[@]}"; do
    if [[ " ${WHOLE_TEXT[*]} " == *" $kind "* ]]; then
      report "$kind" "${RULES[$kind]}" RECIPE.md "$dir/RECIPE.md"
    else
      report "$kind" "${RULES[$kind]}" RECIPE.md "$code_view"
    fi
    for rel in "${files[@]}"; do
      report "$kind" "${RULES[$kind]}" "$rel" "$dir/$rel"
    done
    # Hidden text, wherever it is: HTML comments, and invisible characters
    # matched as bytes.
    if [[ $kind == "hides or decodes content" ]]; then
      report "$kind" '<!--' RECIPE.md "$dir/RECIPE.md"
      while IFS= read -r hit; do
        [[ -n $hit ]] || continue
        echo "$kind: ${hit%%:*}:$(cut -d: -f2 <<<"$hit"): invisible characters"
      done < <(cd "$dir" && LC_ALL=C grep -HnP -- "$HIDDEN_BYTES" RECIPE.md "${files[@]}" 2>/dev/null || true)
    fi
  done
)

if [[ -n $output ]]; then
  echo "$output"
else
  echo "no warning signs"
fi
